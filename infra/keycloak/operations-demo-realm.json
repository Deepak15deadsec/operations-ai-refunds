{
  "realm": "operations-demo",
  "displayName": "Operations AI (local demo)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 7200,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "operator", "description": "View tenant data and start investigations" },
      { "name": "supervisor", "description": "Operator + approve/reject proposed actions" },
      { "name": "admin", "description": "Supervisor + audit and administration pages" }
    ]
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"Username\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"Email\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"First name\",\"validations\":{\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"Last name\",\"validations\":{\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"tenant_id\",\"displayName\":\"Tenant ID\",\"validations\":{},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[]}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "operations-web",
      "name": "Operations AI web console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${AUTH_KEYCLOAK_SECRET:local-development-only-change-me}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${WEB_ORIGIN:http://localhost:3000}/api/auth/callback"],
      "webOrigins": ["${WEB_ORIGIN:http://localhost:3000}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${WEB_ORIGIN:http://localhost:3000}/*"
      },
      "defaultClientScopes": ["profile", "roles", "basic"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "operations-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "operations-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "operations-cli",
      "name": "DEV ONLY: password grant for scripts and API smoke tests",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": ["profile", "roles", "basic"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "operations-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "operations-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "operator",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Olivia",
      "lastName": "Operator",
      "email": "operator@acme.example",
      "attributes": { "tenant_id": ["11111111-1111-4111-8111-111111111111"] },
      "credentials": [{ "type": "password", "value": "operator-demo", "temporary": false }],
      "realmRoles": ["operator"]
    },
    {
      "username": "supervisor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Supervisor",
      "email": "supervisor@acme.example",
      "attributes": { "tenant_id": ["11111111-1111-4111-8111-111111111111"] },
      "credentials": [{ "type": "password", "value": "supervisor-demo", "temporary": false }],
      "realmRoles": ["supervisor"]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "email": "admin@acme.example",
      "attributes": { "tenant_id": ["11111111-1111-4111-8111-111111111111"] },
      "credentials": [{ "type": "password", "value": "admin-demo", "temporary": false }],
      "realmRoles": ["admin"]
    },
    {
      "username": "globex-supervisor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Gus",
      "lastName": "Globex",
      "email": "supervisor@globex.example",
      "attributes": { "tenant_id": ["22222222-2222-4222-8222-222222222222"] },
      "credentials": [{ "type": "password", "value": "globex-demo", "temporary": false }],
      "realmRoles": ["supervisor"]
    }
  ]
}
