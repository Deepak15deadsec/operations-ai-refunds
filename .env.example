# Copy to .env. All values here are LOCAL DEVELOPMENT ONLY.

# --- LLM (optional). Default "demo:heuristic" is a deterministic offline stand-in for an LLM so the
# demo works without any key. For a live model set e.g. AGENT_MODEL=openai:gpt-4.1-mini plus its key.
AGENT_MODEL=demo:heuristic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Host ports (change if they clash with something already running)
WEB_PORT=3000
API_PORT=8000
KEYCLOAK_PORT=8080
POSTGRES_PORT=5432

# --- Secrets (replace for anything beyond a laptop demo)
POSTGRES_PASSWORD=local_only
KEYCLOAK_ADMIN_PASSWORD=local-development-only
AUTH_KEYCLOAK_SECRET=local-development-only-change-me
SESSION_SECRET=local-development-only-session-secret-change-me
MCP_RUN_TOKEN_SECRET=local-development-only-change-me

# --- Behaviour
LOG_LEVEL=INFO
MAX_BATCH_TICKETS=10
MAX_CONCURRENT_TICKET_RUNS=2
APPROVAL_TTL_HOURS=24
SEED_DEMO=true

# --- Variables used inside containers are derived in docker-compose.yml:
# DATABASE_URL, MCP_DATABASE_URL, LANGGRAPH_DATABASE_URL (search_path=langgraph),
# OIDC_ISSUER_URL (public, must equal token iss), OIDC_JWKS_URL (internal),
# OIDC_AUDIENCE=operations-api, OIDC_TENANT_CLAIM=tenant_id, MCP_INTERNAL_URL.
